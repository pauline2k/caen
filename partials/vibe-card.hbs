{{!-- Post Card --}}
  {{#if feature_image}}
    <a href="{{url}}" title="{{title}}" aria-label="{{title}}">
    <figure class="post-hero__image post-hero__image-vibe">
      <img class="lazyload"
          data-srcset="{{img_url feature_image size="s"}} 300w,
                  {{img_url feature_image size="m"}} 600w,
                  {{img_url feature_image size="l"}} 1000w,
                  {{img_url feature_image size="xl"}} 2000w"
          data-sizes="(max-width: 1000px) 50vw, 700px"
          data-src="{{img_url feature_image size="l"}}"
          src="{{asset 'images/img-placeholder-md.jpg'}}"
          alt="{{title}}"
      />
            <figcaption>
              {{title}}:
              {{#if meta_description}}
              {{meta_description}}
              {{else}}
              {{excerpt}}
              {{/if}}
            </figcaption>
    </figure>
    </a>
  {{else}}
    <h2 class="post-card__title">
      <a href="{{url}}" title="{{title}}" aria-label="{{title}}">{{title}}</a>
    </h2>

      {{#if meta_description}}
      <div class="post-card__excerpt">
        {{meta_description}}
      </div>
      {{else}}
      <div class="post-card__excerpt">
        {{excerpt words="30"}}
      </div>
      {{/if}}
  {{/if}}
