<div class="hero" style="background-image: url({{asset 'images/voting-guide-cityscape.webp'}})">
  <div class="hero-top">
    <div class="masthead">
      <h1 class="orb">ORB <span class="orb-subtitle">Voting&nbsp;Guide&nbsp;2026</span></h1>
    </div>
  </div>

  <section class="section section-featured">
  {{#get "posts" filter="tag:voting-guide-2026+tag:hash-homepage-special-feature" include="authors,tags" limit="all"}}
    {{#foreach posts}}
      <div class="article article-special-feature">
        <div class="article-inner article-inner-wide">
          <a class="article-special-feature-img-outer" href="{{url}}">
            <div
              class="article-special-feature-img"
              style="background-image: url('{{img_url feature_image}}');"
            >
            </div>
          </a>
          <div class="article-special-feature-inner">
            <a href="{{url}}" title="{{title}}">
              <h2 class="article-title">{{title}}</h2>
            </a>
            <a href="{{url}}" title="{{title}}">
              {{#if meta_description}}
                <p class="article-dek">{{meta_description}}</p>
              {{else}}
              {{#if excerpt}}
                <p class="article-dek">{{excerpt}}</p>
              {{/if}}
              {{/if}}
            </a>
            {{^has author='\O/,Oakland Review of Books'}}
              <p class="m-0 m-t-sm"><span class="article-author">{{authors separator=", "}}</span></p>
            {{/has}}
          </div>
        </div>
      </div>
    {{/foreach}}
  {{/get}}


