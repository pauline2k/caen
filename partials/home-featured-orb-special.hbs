      {{else}}
      {{#has tag="#homepage-tile-2"}}
        <div class="article article-tile-2">
      {{else}}
      {{#has tag="#homepage-tile-3"}}
        <div class="article article-tile-3">
      {{else}}
      {{#has tag="#homepage-tile-4"}}
        <div class="article article-tile-4">
      {{else}}
        <div class="article article-tile-5">
      {{/has}}
      {{/has}}
      {{/has}}
      {{/has}}      
          <div class="article-inner">
            <a href="{{url}}" title="{{title}}">
              <h2 class="article-title">{{title}}</h2>
            </a>
            {{^has author='\O/,Oakland Review of Books'}}
              <a href="{{primary_author.url}}" title="{{primary_author.name}}">            
                <p class="m-0 m-t-sm"><span class="article-author">{{primary_author.name}}</span></p>
              </a>
            {{/has}}
          </div>
        </div>
      {{/has}}
      {{/has}}
    {{/foreach}}
  {{/get}}
  </section>
</div>