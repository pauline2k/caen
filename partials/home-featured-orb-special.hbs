      {{else}}
      {{#has tag="#homepage-wide-2"}}
        <div class="article article-wide-2">
      {{else}}
      {{#has tag="#homepage-wide-3"}}
        <div class="article article-wide-3">
      {{else}}
      {{#has tag="#homepage-wide-4"}}
        <div class="article article-wide-4">
      {{else}}
        <div class="article article-wide-5">
      {{/has}}
      {{/has}}
      {{/has}}
      {{/has}}
          <div class="article-inner article-inner-wide">
            <div>
              <a href="{{url}}" title="{{title}}">
                <h2 class="article-title">{{title}}</h2>
