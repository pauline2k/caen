<div class="hero">
  <div class="hero-top">
    <div class="masthead" aria-hidden="true">
      <div class="orb">ORB</div>
    </div>

    <div class="calendar-link-sm">
      {{#get "posts" filter="tag:calendar" limit="1"}}
        {{#foreach posts}}
          <a href="{{url}}" data-title="{{title}}">
            <h2 class="sidebar-calendar-header">
              Events Calendar
            </h2>
            <div class="sidebar-calendar-label" data-title="{{title}}"></div>
          </a>
        {{/foreach}}
      {{/get}}
    </div>

    <div class="hero-top-pill-stack">
      {{#if @member}}
        <a class="pill btn pill-subscribe" href="/#/portal/account">ACCOUNT</a>
      {{else}}
        <a class="pill" href="/#/portal/signin/">LOGIN</a>
        <a class="pill btn pill-subscribe" href="/#/portal/signup/">SUBSCRIBE</a>
      {{/if}}
    </div>
  </div>

  <section class="section section-featured latest-post">
  {{#get "posts" filter="featured:true+tag:hash-homepage-special-feature" include="authors,tags" limit="all"}}
    {{#foreach posts}}
      <div class="article article-special-feature">
        <div class="article-inner article-inner-wide">
          <a class="article-special-feature-img-outer" href="{{url}}">
            <div
              class="article-special-feature-img"
              style="background-image: url('{{img_url feature_image}}');"
            >
            </div>
          </a>
          <div class="article-special-feature-inner">
            <a href="{{url}}" title="{{title}}">
              <h2 class="article-title">{{title}}</h2>
            </a>
            <a href="{{url}}" title="{{title}}">
              {{#if meta_description}}
                <p class="article-dek">{{meta_description}}</p>
              {{else}}
              {{#if excerpt}}
                <p class="article-dek">{{excerpt}}</p>
              {{/if}}
              {{/if}}
            </a>
            {{^has author='\O/,Oakland Review of Books'}}
              <a href="{{primary_author.url}}" title="{{primary_author.name}}">
                <p class="m-0 m-t-sm"><span class="article-author">{{primary_author.name}}</span></p>
              </a>
            {{/has}}
          </div>
        </div>
      </div>
    {{/foreach}}
  {{/get}}


  {{#get "posts" filter="featured:true+tag:-calendar+tag:-hash-homepage-special-feature" include="authors,tags" limit="all"}}
    {{#foreach posts}}
      {{#has tag="#homepage-wide-1,#homepage-wide-2,#homepage-wide-3,#homepage-wide-4,#homepage-wide-5"}}

