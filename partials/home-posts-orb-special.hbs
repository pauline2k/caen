<section class="home-posts orb-table" data-orb-table>
  {{!-- Tag filter pills (client-side filter of the already-rendered rows) --}}
  <nav class="orb-pills" aria-label="Filter posts by tag">
    <button class="pill-lower" type="button" data-tag="vibe-reports" aria-pressed="false">
      Vibe Reports
    </button>
    <button class="pill-lower" type="button" data-tag="reviews" aria-pressed="false">
      Reviews
    </button>
    <button class="pill-lower is-active" type="button" data-tag="all" aria-pressed="true">
      The complete ORB
    </button>
  </nav>

  <div class="orb-rows" role="table" aria-label="Articles">
    {{#get "posts" filter="featured:false+tag:-calendar" include="authors,tags" limit="50"}}
      {{#foreach posts}}
        <article
          class="orb-row"
          role="row"
          data-tags="{{#foreach tags}}{{slug}}{{^last}} {{/last}}{{/foreach}}"
        >
          <div class="c c--section" role="cell">
            <div>{{tags limit="1"}}</div>
            <div>{{date format="M/D/YY"}}</div>
          </div>

          <div class="c c--title" role="cell">
            <a class="orb-title-link" href="{{url}}">{{title}}</a>
          </div>

          <div class="c c--dek" role="cell">
            {{#if meta_description}}
              {{meta_description}}
            {{else}}
            {{#if custom_excerpt}}
              {{custom_excerpt}}
            {{else}}
              {{excerpt words="25"}}…
            {{/if}}
            {{/if}}
          </div>

          <div class="c c--author" role="cell">
            {{^has author='\O/'}}
              <a href="{{primary_author.url}}">
                {{primary_author.name}}
              </a>
            {{/has}}
          </div>
        </article>
      {{/foreach}}
    {{/get}}
  </div>

  <div class="index-more-posts-outer">
    <a class="pill btn pill-lower pill-lower-more-posts" href="">More</a>
  </div>

  <script>
    (() => {
      const root = document.querySelector("[data-orb-table]");
      if (!root) return;

      const pills = Array.from(root.querySelectorAll(".pill-lower[data-tag]"));
      const rows = Array.from(root.querySelectorAll(".orb-row[data-tags]"));

      function setActivePill(tag) {
        pills.forEach(btn => {
          const isActive = btn.dataset.tag === tag;
          btn.classList.toggle("is-active", isActive);
          btn.setAttribute("aria-pressed", isActive ? "true" : "false");
        });
      }

      function applyFilter(tag) {
        const wanted = (tag || "all").toLowerCase();
        let visible = 0;

        rows.forEach(row => {
          const tagList = (row.getAttribute("data-tags") || "").toLowerCase().split(/\s+/).filter(Boolean);
          const show = (visible < 8) && (wanted === "all" || tagList.includes(wanted));
          row.style.display = show ? "" : "none";
          if (show) visible += 1;
        });

        setActivePill(wanted);
        if (wanted === "all") {
          root.querySelector(".pill-lower-more-posts").href = "/vault";
        } else {
          root.querySelector(".pill-lower-more-posts").href = `/tag/${wanted}`;
        }
      }

      // Click handling
      pills.forEach(btn => {
        btn.addEventListener("click", () => applyFilter(btn.dataset.tag));
      });

      const initial = "vibe-reports";
      const hasInitialPill = pills.some(b => b.dataset.tag === initial);
      applyFilter(hasInitialPill ? initial : "all");
    })();
  </script>
</section>