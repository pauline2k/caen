{{!-- Related Posts --}}
{{#get "posts" include="tags,authors" limit="3" filter="id:-{{comment_id}}+tag:{{primary_tag.slug}}" as |related|}}
  <section class="related-posts">
    <div class="container-fluid wrapper">
      <h5 class="section__title" style="margin-bottom:20px;">{{t "Then again..."}}</h5>
      <div class="row posts posts-related">
        {{#foreach related}}
          <div class="col-xs-12 col-md-6 col-lg-4 post-wrap">
            {{> post-card class="col"}}
          </div>
        {{/foreach}}
      </div>
    </div>
  </section>
{{/get}}
