<div class="row">
  <div class="col-xs-12 col-lg-12 col-xl-12">
    <section class="section all-posts">
      <div class="row posts">
        {{#foreach posts from="2"}}
          <div class="col-xs-12 post-wrap">
            {{> post-card}}
          </div>
        {{/foreach}}
      </div>
      <a id="load-more" name="load-more"></a>
      <div class="row">
        <div class="col-xs-12 center-xs">
          <button id="load-more-posts" class="btn btn--wide btn--brand btn--bordered">
            {{t "Load more posts"}}
          </button>
        </div>
      </div>
    </section>
  </div>
</div>