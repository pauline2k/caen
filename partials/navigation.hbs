<ul class="nav">
  {{#if @member}}
    <li><a class="signout-link" href="#signout" data-members-signout>{{t "Log out"}}</a></li>
    <li><a class="account-link" href="/account/"{{#if @custom.use_portal_links}} data-portal="account"{{/if}}>{{t "Account"}}</a></li>
  {{else}}
    <li><a class="signin-link" href="/signin/"{{#if @custom.use_portal_links}} data-portal="signin"{{/if}}>{{t "Log in"}}</a></li>
    <li><a class="signup-link header-cta" href="/signup/"{{#if @custom.use_portal_links}} data-portal="signup"{{/if}}>{{t "Subscribe"}}</a></li>
  {{/if}}
</ul>
