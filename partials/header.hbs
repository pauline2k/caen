{{!-- Site header --}}
{{#is "home"}}
<header class="header header__home">
{{else}}
<header class="header">
{{/is}}
  <div id="progress"></div>
  <div class="header__top">
    <div>
      {{!-- Blog logo or name --}}
      <div class="header__brand flex-cc">
        <a href="{{@site.url}}">
          {{#if @site.logo}}
            <img class="header__logo" src="{{@site.logo}}" alt="{{@site.title}}">
          {{else}}
            <h3 class="header__title">{{@site.title}}</h3>
          {{/if}}
        </a>
      </div>
    </div>
        
    <div>
      {{!-- Member Links --}}
        <div class="header__member">
          <a class="header__member--open hamburger" tabindex="0" aria-label="{{t "Menu"}}">
                        <span></span>

          </a>
          <ul class="header__member-options">
            {{#if @member}}
              <li><a tabindex="0" href="#/portal/account" title="{{t "Account"}}" aria-label="{{t "Account"}}">{{t "Account"}}</a></li>
            {{else}}
              <li><a tabindex="0" href="#/portal/signup/" title="{{t "Subscribe!"}}" aria-label="{{t "Subscribe!"}}">{{t "Subscribe!"}}</a></li>
              <li><a tabindex="0" href="#/portal/signin/" title="{{t "Log In"}}" aria-label="{{t "Log In"}}">{{t "Log In"}}</a></li>
            {{/if}}
            <li><a tabindex="0" href="/about" title="{{t "About"}}" aria-label="{{t "About"}}">{{t "About"}}</a></li>
            <li><a data-ghost-search tabindex="0" href="" title="{{t "Search"}}" aria-label="{{t "Search"}}">{{t "Search"}}</a></li>
            <li><a tabindex="0" href="/stacks" title="{{t "Archive"}}" aria-label="{{t "Archive"}}">{{t "Archive"}}</a></li>
            <li><a tabindex="0" href="/pitch-us" title="{{t "Pitch Us!"}}" aria-label="{{t "Pitch Us!"}}">{{t "Pitch Us!"}}</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</header>