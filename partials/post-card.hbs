{{!-- Post Card --}}
<div class="post-card{{#if class}} {{class}}{{/if}} no-img {{#if featured}} featured{{/if}}">

  <div class="post-card__content">
    <h2 class="post-card__title">
      <a href="{{url}}">{{excerpt words="30"}}</a>
    </h2>

    <div class="post-card__header">
      <div class="post-card__excerpt">
        <a href="{{url}}">
          <strong>{{title}}</strong> &bull;
          {{^has author="Oakland Review of Books,\O/"}}
          {{#authors separator=", "}}{{/authors}} &bull;
          {{/has}}
          <time datetime="{{date format='YYYY-MM-DD'}}" class="post-card__date">
            {{date published_at timeago=""}}
          </time>
        </a>
      </div>
    </div>
  </div>

</div>