{{!< default}}

<div class="index-page">
  <div class="index-page-featured">
    {{> home-featured-orb-special}}
  </div>

  <aside class="sidebar">
    <div class="sidebar__inner">
      <section>
        {{#get "posts" filter="tag:calendar" limit="1"}}
          {{#foreach posts}}
            <a href="{{url}}" data-title="{{title}}">
              <h2 class="sidebar-calendar-header">
                Events Calendar
              </h2>
              <div class="sidebar-calendar-label" data-title="{{title}}"></div>
                <div class="index-calendar-image" style="background-image: url({{feature_image}});">
                  <div class="index-calendar-image-inner">
                    \O/
                  </div>
                </div>
              <div class="sidebar-calendar-excerpt">{{excerpt}}</div>
            </a>
          {{/foreach}}
        {{/get}}
      </section>

      {{#if @custom.sidebar_banner_text}}
      <section>
        <div class="sidebar__announcement-banner">
          {{ @custom.sidebar_banner_text }}
        </div>
      </section>
      {{/if}}

      <section>
        <a class="pill sidebar-pill" href="/about">About</a>
        <a class="pill sidebar-pill" data-ghost-search href="">Search</a>
        <a class="pill sidebar-pill" href="/pitch-us">Pitch Us!</a>
      </section>

      {{#if @site.members_enabled}}
        <form class="subscribe-form" data-members-form="subscribe">
          <input aria-labelledby="footer-subscribe" data-members-email type="email" placeholder="email@email.com" required/>
          <button type="submit" class="pull sidebar-pill sidebar-pill-subscribe">
            Subscribe!
          </button>
          <div class="message message-success">
            <div class="message__header">
              <div class="message__type">{{t "Success"}}</div> 
              <div class="message__close js-msg-close">{{>icon name="x" size="xs"}}</div>
            </div>
            <div class="message__content">
              {{t "Great! Check your inbox and click the link to confirm your subscription"}}
            </div>
          </div>
          <p data-members-error><!-- error message will appear here --></p>
        </form>
      {{/if}}
    </div>
  </aside>

  <section class="mobile-bar">
    <!-- narrow-screen replacement row -->
  </section>

  {{> home-posts-orb-special}}

  <section class="index-page-syllabus">
    <a href="/introducing-the-oakland-review-of-books-syllabus/">
      <h2 class="index-page-syllabus-hed">
        Oakland Syllabus
      </h2>
      <div class="index-page-syllabus-dek">
        Most of us at ORB have this question in common: how do you really know this place? Can you? Enter: the Oakland Review of Books syllabus.
      </div>
    </a>
  </section>

  <section class="index-page-footer">
    {{> footer}}
  </section>

  <script>
    document.querySelectorAll('.sidebar-calendar-label').forEach(el => {
      const full = el.dataset.title;
      const parts = full.split(',');
      el.textContent = parts.length > 1 ? parts.slice(1).join(',').trim() : full;
    });
  </script>


</div>