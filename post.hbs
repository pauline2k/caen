{{!< default}}

{{!-- Everything inside the #post tags pulls data from the post --}}
{{#post}}
<div class="container-fluid color-background">
  <div class="row">
    <div class="col-xs-12 col-lg-12 col-xl-12 post__outer">
      <article class="{{post_class}} post-access-{{visibility}}">
        <div class="post__content no-overflow">
          <div class="post-header">
            <h1 class="post-hero__title">{{title}}</h1>

            {{#if meta_description}}
            <div class="post-hero__excerpt">
              {{meta_description}}
            </div>
            {{else}}
            {{#has tag='vibe reports,calendar'}}
            {{#if excerpt}}
            <div class="post-hero__excerpt">
              {{excerpt}}
            </div>
            {{/if}}
            {{/has}}
            {{/if}}

            {{^has author='\O/'}}
            <div class="post-hero__author-names">
              {{#authors separator=", "}}{{/authors}}
            </div>
            {{/has}}

          </div>

          {{> post-hero}}

          <div class="post-metadata">
            <time datetime="{{date format='YYYY-MM-DD'}}">
              {{date published_at timeago=""}}
            </time>
            &bull;
            {{tags separator=", "}}
          </div>
          {{#if access}}
            {{content}}
          {{else}}
            {{> content-cta fading=true}}
          {{/if}}
        </div>

        {{#if access}}
          <div class="post-width">
            {{#unless @member}}
              <hr>
              {{> subscribe}}
            {{/unless}}
            <hr>
            {{!-- Include Comments: Native, Cove or Disqus --}}
            {{comments 
              title=""
              count=false
              mode=auto
            }}
            {{!-- <hr class="m-t m-b-lg"> --}}
          </div>
        {{/if}}
      </article>
    </div>
  </div>
</div>

{{/post}}
