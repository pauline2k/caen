{{!< default}}

<div class="container-fluid wrapper">
  {{!-- Everything inside the #tag pulls data from the tag --}}
  {{!-- Tag header --}}
  {{#tag}}
    <section class="tag-header{{^if feature_image}} no-img{{/if}}">
      <div class="geometric-bg"></div>
      {{#if feature_image}}
        <div class="tag-header__image">
          <img class="lazyload"
              data-srcset="{{img_url feature_image size="s"}} 300w,
                      {{img_url feature_image size="m"}} 600w,
                      {{img_url feature_image size="l"}} 1000w,
                      {{img_url feature_image size="xl"}} 2000w"
              data-sizes="(max-width: 1000px) 50vw, 700px"
              data-src="{{img_url feature_image size="l"}}"
              alt="{{name}}" 
              src="{{asset 'images/img-placeholder-md.jpg'}}"
          />
        </div>
      {{/if}}

      <div class="tag-header__content">
        <h1 class="tag-header__title">{{name}}</h1>
        {{#if description}}
          <div class="tag-header__description">{{description}}</div>
        {{/if}}
        <div class="tag-header__counter">
          {{plural ../pagination.total empty=(t 'No posts') singular=(t '1 post') plural=(t '% posts')}}
        </div>
      </div>
    </section>
  {{/tag}}

  {{!-- The main content/post by the author --}}
  {{#if posts}}
    <div class="row">
      <div class="col-xs-12">
        <section class="section all-posts">
          <div class="orb-rows" role="table" aria-label="Articles">
              {{#foreach posts}}
                {{!-- Collect tag slugs to filter on --}}
                <article
                  class="orb-row"
                  role="row"
                  data-tags="{{#foreach tags}}{{slug}}{{^last}} {{/last}}{{/foreach}}"
                >
                  <div class="c c--section" role="cell">
                    <div>{{tags limit="1"}}</div>
                    <div>{{date format="M/D/YY"}}</div>
                  </div>

                  <div class="c c--title" role="cell">
                    <a class="orb-title-link" href="{{url}}">{{title}}</a>
                  </div>

                  <div class="c c--dek" role="cell">
                    {{#if meta_description}}
                      {{meta_description}}
                    {{else}}
                    {{#if custom_excerpt}}
                      {{custom_excerpt}}
                    {{else}}
                      {{excerpt words="25"}}…
                    {{/if}}
                    {{/if}}
                  </div>

                  <div class="c c--author" role="cell">
                    {{^has author='\O/'}}
                      {{primary_author.name}}
                    {{/has}}
                  </div>
                </article>
              {{/foreach}}
          </div>
        </section>
      </div>
    </div>
  {{/if}}
</div>