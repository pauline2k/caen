<!DOCTYPE html>
<html lang="{{@site.locale}}" data-color-scheme="light">
  <head>
    {{!-- Document Settings --}}
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    {{!-- Page Meta --}}
    <title>{{#is "account"}}{{t "Account"}} - {{else}}{{#is "signin"}}{{t "Sign in"}} - {{else}}{{#is "signup"}}{{t "Sign up"}} - {{/is}}{{/is}}{{/is}}{{meta_title}}</title>

    {{!-- Mobile Meta --}}
    <meta name="HandheldFriendly" content="True" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" /> 

    {{!-- PWA --}}
    <link rel="manifest" href="{{asset 'manifest.webmanifest'}}">
    <meta name="theme-color" content="{{@site.accent_color}}">
    <link rel="apple-touch-icon" href="{{asset 'icon-192x192.png'}}">

    {{!-- Preloading --}}
    <link rel="preload" href="{{asset 'dist/app.min.js'}}" as="script">
    <link rel="preload" href="{{asset 'dist/app.min.css'}}" as="style">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:ital,wght@0,100..900;1,100..900&family=Sorts+Mill+Goudy:ital@0;1&family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&display=swap" rel="stylesheet">

    <style>
      body { 
        --font-family-sans-serif: 'Libre Franklin';
        --font-family-secondary: 'Sorts Mill Goudy';
      }
      body h1,body h2,body h3,body h4,body h5,body h6 { font-family: 'Libre Franklin'; }
    </style>

    {{!-- Theme Configuration --}}
    {{> theme-config}}

    {{!-- Styles --}}
    <link rel="stylesheet" type="text/css" href="{{asset 'dist/app.min.css'}}" />

    {{!-- Theme scripts --}}
    <script async defer src="{{asset 'dist/app.min.js'}}"></script>

    <!--cssential--><style></style><!--/cssential-->

    {{!-- Ghost outputs important style and meta data with this tag --}}
    {{ghost_head}}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    
<style>
  .center-screen-collage {
      background-image: url({{@site.cover_image}});
  }
</style>


  </head>
  <body class="{{body_class}}{{#is "page"}}{{#unless @page.show_title_and_feature_image}} page-no-title{{/unless}}{{/is}}">
    {{!-- Include Search View --}}
    {{!-- {{> search}} --}}

    {{!-- Include Menu --}}
    {{> menu}}

    {{!-- The blog navigation links --}}
    {{^is "signin, signup"}}
      {{> header}}
    {{/is}}

    <main class="main">
      {{!-- All the main content gets inserted here, index.hbs, post.hbs, etc --}}
      {{{body}}}
    </main>

    {{!-- The footer at the very bottom --}}
    {{^is "signin, signup, home"}}
      {{> footer}}
      <div class="scroll-to-top">{{> icon name="arrow-up"}}</div>
    {{/is}}

    {{> gradient}}

    {{!-- Service Worker for PWA --}}
    <script>
      if (config.enable_pwa && 'serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js');
        });
      }
    </script>

    {{!-- Ghost outputs important scripts and data with this tag --}}
    {{ghost_foot}}
  </body>
</html>
